# cp .env.example .env して、NAS の実際のパスに書き換える

# 音楽フォルダ(NAS 上のパス)
MUSIC_LOSSLESS=/home/cross/1.music/Lossless
MUSIC_LOSSY=/home/cross/1.music/1.Lossy
# 歌詞フォルダ(「アーティスト - 曲名.lrc / .txt」が並ぶ。中のフォルダも探す)
MUSIC_LYRICS=/home/cross/1.music/lyrics

# データベースとカバー画像の置き場所(書き込める場所)
OTOKURA_DATA_DIR=./data

# 動かすユーザー。NAS に SSH して `id` を実行し、uid と gid の数字を書く
PUID=1000
PGID=10

# ブラウザで開くポート
OTOKURA_PORT=8686

# Google Cast の機器(Nest・Chromecast)と DLNA の機器が曲を取りに来る、家の中の NAS のアドレス
# DLNA の機器は、このアドレスと同じネットワーク(/24)から探す
OTOKURA_CAST_URL=http://192.168.0.252:8686

# 変換したファイル(ALAC・TAK・WMA など、CUE シートの曲)を残しておく上限(GB)
OTOKURA_TRANSCODE_MAX_GB=20

# アーティスト画像・アルバム情報を Web(MusicBrainz・Wikipedia・Deezer・iTunes)から取る。0 で無効
OTOKURA_WEBINFO=1
